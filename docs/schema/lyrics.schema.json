{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "comment": {
                "type": "string"
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "text-unverified",
                    "timing-draft",
                    "translation-draft",
                    "comment-draft",
                    "attribution-unverified"
                  ]
                }
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "at": {
                      "type": "number",
                      "minimum": 0
                    },
                    "until": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "key",
                    "at"
                  ],
                  "additionalProperties": false
                }
              },
              "kind": {
                "type": "string",
                "const": "vocal"
              },
              "voice": {
                "type": "string"
              },
              "lines": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]+$"
                    },
                    "lang": {
                      "type": "string"
                    },
                    "script": {
                      "type": "string"
                    },
                    "words": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "w": {
                            "type": "string",
                            "minLength": 1
                          },
                          "s": {
                            "type": "number",
                            "minimum": 0
                          },
                          "e": {
                            "type": "number",
                            "minimum": 0
                          },
                          "br": {
                            "type": "boolean"
                          },
                          "em": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "w",
                          "s",
                          "e"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "alt": {
                      "type": "object",
                      "properties": {
                        "script": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "script",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    "translit": {
                      "type": "string"
                    },
                    "tr": {
                      "type": "object",
                      "properties": {
                        "ru": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "ru"
                      ],
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "comment": {
                      "type": "string"
                    },
                    "voice": {
                      "type": "string"
                    },
                    "fx": {
                      "type": "string",
                      "enum": [
                        "auto",
                        "rise",
                        "focus",
                        "ink",
                        "assemble",
                        "drop",
                        "bloom",
                        "cascade",
                        "spotlight",
                        "stack",
                        "whisper"
                      ]
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "text-unverified",
                          "timing-draft",
                          "translation-draft",
                          "comment-draft",
                          "attribution-unverified"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "lang",
                    "script",
                    "words",
                    "tr"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "start",
              "end",
              "label",
              "kind",
              "lines"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "comment": {
                "type": "string"
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "text-unverified",
                    "timing-draft",
                    "translation-draft",
                    "comment-draft",
                    "attribution-unverified"
                  ]
                }
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "at": {
                      "type": "number",
                      "minimum": 0
                    },
                    "until": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "key",
                    "at"
                  ],
                  "additionalProperties": false
                }
              },
              "kind": {
                "type": "string",
                "const": "instrumental"
              },
              "instruments": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "performers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "mode": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "layout": {
                "type": "string",
                "enum": [
                  "single",
                  "pair-sides",
                  "pair-diagonal",
                  "stack",
                  "fan",
                  "hero-insets",
                  "grid"
                ]
              }
            },
            "required": [
              "id",
              "start",
              "end",
              "label",
              "kind",
              "instruments"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "sections"
  ],
  "additionalProperties": false
}
