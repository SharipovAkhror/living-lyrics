{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "titleOriginal": {
      "type": "string"
    },
    "artist": {
      "type": "string",
      "minLength": 1
    },
    "featuring": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "album": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "poets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "lang": {
            "type": "string"
          },
          "era": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "palette": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accentDark": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "field": {
          "minItems": 3,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      },
      "required": [
        "accent",
        "accentDark",
        "field"
      ],
      "additionalProperties": false
    },
    "coverGlyph": {
      "type": "string",
      "description": "Не используется. Обложка рисуется только цветом песни, без букв и знаков. Поле оставлено, чтобы старые файлы песен проходили проверку."
    },
    "audio": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "missing",
            "ready"
          ]
        },
        "high": {
          "type": "string"
        },
        "saver": {
          "type": "string"
        },
        "peaks": {
          "type": "string"
        },
        "gainDb": {
          "type": "number"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "file",
                "url",
                "purchase"
              ]
            },
            "ref": {
              "type": "string"
            },
            "retrieved": {
              "type": "string"
            },
            "codec": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "aligned",
            "verified"
          ]
        },
        "method": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "method"
      ],
      "additionalProperties": false
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "lang": {
            "type": "string"
          },
          "author": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "years": {
                "type": "string",
                "minLength": 1
              },
              "original": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "work": {
            "type": "object",
            "properties": {
              "original": {
                "type": "string",
                "minLength": 1
              },
              "ru": {
                "type": "string",
                "minLength": 1
              },
              "lang": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?:\\/\\/\\S+$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "lang",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "slug",
    "title",
    "artist",
    "languages",
    "duration",
    "palette",
    "audio",
    "timing"
  ],
  "additionalProperties": false
}
