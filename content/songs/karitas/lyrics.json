  "sections": [
    {
      "id": "overture",
      "kind": "instrumental",
      "start": 0,
      "end": 38,
      "label": "Увертюра",
      "instruments": [
        "qanun",
        "oud",
        "bendir",
        "daf"
      ],
      "mode": "Баяти-шираз",
      "note": "Рамочные барабаны задают пульс, канун и уд намечают лад.",
      "comment": "**Макам** (مقام) — ладовая система ближневосточной музыки: звукоряд, характерные обороты, порядок движения мелодии и настроение. По описанию релиза, в «Karitas» звучат макамы баяти-шираз и раст.\n\nРамочные барабаны — **даф** и **бендир** — в суфийской традиции сопровождают зикр; их ровный пульс здесь держит всю увертюру.",
      "flags": [
        "timing-draft",
        "attribution-unverified"
      ]
    },
    {
