              "s": 71.03,
              "e": 72.75
            }
          ],
          "translit": "Зафирту би хаккан ба‘да ль-фана",
          "tr": {
            "ru": "и воистину обрёл себя — после угасания."
          },
          "flags": [
            "text-unverified",
