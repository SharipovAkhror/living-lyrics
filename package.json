{
  "name": "living-lyrics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kinetic lyrics stage with word-level sync, layered translation and commentary.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "validate": "tsx scripts/tools/validate.ts",
    "draft-timing": "tsx scripts/tools/draft-timing.ts",
    "new-song": "tsx scripts/tools/new-song.ts",
    "art": "node scripts/art/build-instruments.mjs",
    "shots": "node scripts/tools/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/noto-nastaliq-urdu": "5.3.0",
    "@vercel/functions": "3.10.1",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "zod": "4.6.7"
  }
}
