{
  "name": "living-lyrics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kinetic lyrics stage with word-level sync, layered translation and commentary.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/tools/audio-crypt.mjs decrypt && npm run validate && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "validate": "tsx scripts/tools/validate.ts",
    "draft-timing": "tsx scripts/tools/draft-timing.ts",
    "new-song": "tsx scripts/tools/new-song.ts",
    "song-status": "tsx scripts/tools/song-status.ts",
    "art": "node scripts/art/build-instruments.mjs",
    "art3d": "node scripts/art3d/build.mjs",
    "test:layout": "tsx scripts/tools/layout-test.ts",
    "test:resume": "node scripts/perf/resume-crash.mjs",
    "shots": "node scripts/tools/screenshots.mjs",
    "predev": "node scripts/tools/audio-crypt.mjs decrypt",
    "audio:encrypt": "node scripts/tools/audio-crypt.mjs encrypt",
    "rotate-key": "node scripts/tools/rotate-audio-key.mjs",
    "perf:iphone": "node scripts/perf/long-run.mjs",
    "perf:settings": "node scripts/perf/settings-trace.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/noto-nastaliq-urdu": "5.3.0",
    "@fontsource/scheherazade-new": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@vercel/functions": "3.10.1",
    "marked": "18.1.1",
    "meshoptimizer": "1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "zod": "4.6.7"
  }
}
